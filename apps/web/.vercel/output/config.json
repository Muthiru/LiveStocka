{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_fonts/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_fonts(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/reproduction",
      "dest": "/reproduction"
    },
    {
      "src": "/reports",
      "dest": "/reports"
    },
    {
      "src": "/register",
      "dest": "/register"
    },
    {
      "src": "/milk-production",
      "dest": "/milk-production"
    },
    {
      "src": "/login",
      "dest": "/login"
    },
    {
      "src": "/health-records",
      "dest": "/health-records"
    },
    {
      "src": "/family-tree",
      "dest": "/family-tree"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard"
    },
    {
      "src": "/cows",
      "dest": "/cows"
    },
    {
      "src": "/bulk-milk-entry",
      "dest": "/bulk-milk-entry"
    },
    {
      "src": "/breeding",
      "dest": "/breeding"
    },
    {
      "src": "/add-cow",
      "dest": "/add-cow"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/edit-cow/(?<id>[^/]+)",
      "dest": "/edit-cow/[id]"
    },
    {
      "src": "/cow/(?<id>[^/]+)/health",
      "dest": "/cow/[id]/health"
    },
    {
      "src": "/cow/(?<id>[^/]+)",
      "dest": "/cow/[id]"
    },
    {
      "src": "/cow-records/(?<id>[^/]+)",
      "dest": "/cow-records/[id]"
    },
    {
      "src": "/api/_nuxt_icon/(?<collection>[^/]+)",
      "dest": "/api/_nuxt_icon/[collection]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}